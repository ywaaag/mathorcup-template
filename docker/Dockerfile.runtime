ARG BASE_IMAGE=mathorcup-runtime:20260510
FROM ${BASE_IMAGE}

LABEL org.opencontainers.image.title="mathorcup-runtime"
LABEL org.opencontainers.image.description="MathorCup modeling runtime with Python/R/LaTeX/CJK baseline"
LABEL org.opencontainers.image.version="20260705"
LABEL org.opencontainers.image.created="2026-07-05"
LABEL desktop.docker.io/binds/0/Source=""
LABEL desktop.docker.io/binds/0/Target=""
LABEL desktop.docker.io/ports/8787/tcp=""
LABEL desktop.docker.io/ports/8888/tcp=""

ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        fonts-noto-cjk \
        fonts-noto-cjk-extra \
        poppler-utils \
        qpdf \
        unzip \
    && fc-cache -f \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --no-cache-dir \
        PyPDF2 \
        PyMuPDF

RUN Rscript -e "options(repos=c(CRAN='https://cloud.r-project.org')); install.packages(c('ompr','ROI'), Ncpus=2)"

RUN tlmgr init-usertree || true \
    && tlmgr --usermode option repository https://ftp.math.utah.edu/pub/tex/historic/systems/texlive/2023/tlnet-final \
    && tlmgr --usermode install biblatex \
    && mktexlsr /root/texmf

RUN cat > /opt/mathorcup-runtime-baseline.txt <<EOF
mathorcup-runtime portable refresh baseline

Base image:
- ${BASE_IMAGE}

Added/verified layer:
- Noto CJK fonts
- qpdf and poppler-utils
- PyPDF2 and PyMuPDF
- R packages ompr and ROI
- biblatex via TeX Live 2023 user tree under /root/texmf

The repository runtime scripts still decide container name, mounts, GPU,
privileged mode, and root user via rendered .env.
EOF

ENTRYPOINT ["/usr/bin/env"]
CMD ["bash", "-lc", "while true; do sleep 86400; done"]
